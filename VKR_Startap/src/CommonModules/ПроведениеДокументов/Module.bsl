#Область ПрограммныйИнтерфейс

// Формирует движения документа по регистру накопления «Баллы проектов».
//
// Параметры:
//   Движения - КоллекцияДвижений - коллекция движений документа;
//   Проект - СправочникСсылка.Проекты - проект;
//   Этап - СправочникСсылка.ЭтапыПроекта, Неопределено - этап (для заявок не указывается);
//   ТаблицаБаллов - ТаблицаЗначений - строки с колонками Критерий и Балл;
//   Период - Дата - дата движений.
//
Процедура ЗаписатьБаллыПроекта(Движения, Проект, Этап, ТаблицаБаллов, Период) Экспорт

	Для Каждого СтрокаБалла Из ТаблицаБаллов Цикл
		Запись = Движения.БаллыПроектов.Добавить();
		Запись.Период = Период;
		Запись.Проект = Проект;
		Запись.КритерийОценки = СтрокаБалла.Критерий;
		Если Этап <> Неопределено Тогда
			Запись.Этап = Этап;
		КонецЕсли;
		Запись.Баллы = СтрокаБалла.Балл;
	КонецЦикла;

КонецПроцедуры

// Формирует движение документа по регистру сведений «Статусы проектов».
//
// Параметры:
//   Движения - КоллекцияДвижений - коллекция движений документа;
//   Проект - СправочникСсылка.Проекты - проект;
//   Статус - ПеречислениеСсылка.СтатусыПроекта - новый статус;
//   Период - Дата - дата движения;
//   Комментарий - Строка - пояснение к смене статуса.
//
Процедура ЗаписатьСтатусПроекта(Движения, Проект, Статус, Период, Комментарий = "") Экспорт

	Запись = Движения.СтатусыПроектов.Добавить();
	Запись.Период = Период;
	Запись.Проект = Проект;
	Запись.Статус = Статус;
	Запись.Комментарий = Комментарий;

КонецПроцедуры

// Формирует движение документа по регистру сведений «Кураторы проектов».
//
// Параметры:
//   Движения - КоллекцияДвижений - коллекция движений документа;
//   Проект - СправочникСсылка.Проекты - проект;
//   Сотрудник - СправочникСсылка.Сотрудники - назначаемый куратор;
//   РольКуратора - Строка - роль куратора (наставник, трекер);
//   Период - Дата - дата движения.
//
Процедура ЗаписатьКуратораПроекта(Движения, Проект, Сотрудник, РольКуратора, Период) Экспорт

	Запись = Движения.КураторыПроектов.Добавить();
	Запись.Период = Период;
	Запись.Проект = Проект;
	Запись.Сотрудник = Сотрудник;
	Запись.РольКуратора = РольКуратора;

КонецПроцедуры

// Формирует движения документа по регистру накопления «Участие в мероприятиях».
//
// Параметры:
//   Движения - КоллекцияДвижений - коллекция движений документа;
//   ВидМероприятия - СправочникСсылка.ВидыМероприятий - вид мероприятия;
//   ТаблицаУчастников - ТаблицаЗначений - строки с колонками Студент и Проект;
//   Период - Дата - дата движений.
//
Процедура ЗаписатьУчастиеВМероприятии(Движения, ВидМероприятия, ТаблицаУчастников, Период) Экспорт

	Для Каждого СтрокаУчастника Из ТаблицаУчастников Цикл
		Запись = Движения.УчастиеВМероприятиях.Добавить();
		Запись.Период = Период;
		Запись.ВидМероприятия = ВидМероприятия;
		Запись.Студент = СтрокаУчастника.Студент;
		Запись.Проект = СтрокаУчастника.Проект;
		Запись.Количество = 1;
	КонецЦикла;

КонецПроцедуры

// Формирует движения документа по регистру накопления «Финансирование проектов».
//
// Параметры:
//   Движения - КоллекцияДвижений - коллекция движений документа;
//   Проект - СправочникСсылка.Проекты - проект;
//   ТаблицаФинансирования - ТаблицаЗначений - строки с колонками
//     ИсточникФинансирования и СуммаВыделено;
//   Период - Дата - дата движений.
//
Процедура ЗаписатьФинансирование(Движения, Проект, ТаблицаФинансирования, Период) Экспорт

	Для Каждого СтрокаФинансирования Из ТаблицаФинансирования Цикл
		Запись = Движения.ФинансированиеПроектов.Добавить();
		Запись.Период = Период;
		Запись.Проект = Проект;
		Запись.ИсточникФинансирования = СтрокаФинансирования.ИсточникФинансирования;
		Запись.СуммаВыделено = СтрокаФинансирования.СуммаВыделено;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
