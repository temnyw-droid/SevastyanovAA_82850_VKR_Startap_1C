#Область ПрограммныйИнтерфейс

// Рассчитывает итоговый балл по таблице баллов с учётом веса критериев.
//
// Параметры:
//   ТаблицаБаллов - ТаблицаЗначений - строки с колонками Критерий и Балл.
//
// Возвращаемое значение:
//   Число - итоговый взвешенный балл.
//
Функция РассчитатьИтоговыйБалл(ТаблицаБаллов) Экспорт

	Итог = 0;
	Для Каждого СтрокаБалла Из ТаблицаБаллов Цикл
		Вес = 1;
		Если ЗначениеЗаполнено(СтрокаБалла.Критерий) Тогда
			ВесКритерия = СтрокаБалла.Критерий.Вес;
			Если ВесКритерия > 0 Тогда
				Вес = ВесКритерия;
			КонецЕсли;
		КонецЕсли;
		Итог = Итог + СтрокаБалла.Балл * Вес;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Проверяет, достигает ли балл проходного значения допуска.
//
// Параметры:
//   ИтоговыйБалл - Число - проверяемый балл.
//
// Возвращаемое значение:
//   Булево - Истина, если балл не ниже проходного.
//
Функция ПроходитПоБаллу(ИтоговыйБалл) Экспорт

	ПроходнойБалл = Константы.ПроходнойБаллДопуска.Получить();
	Возврат ИтоговыйБалл >= ПроходнойБалл;

КонецФункции

// Возвращает суммарный балл проекта по регистру накопления «Баллы проектов».
//
// Параметры:
//   Проект - СправочникСсылка.Проекты - проект.
//
// Возвращаемое значение:
//   Число - суммарный балл за всё время.
//
Функция СуммарныйБаллПроекта(Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(БаллыПроектовОбороты.БаллыОборот), 0) КАК СуммарныйБалл
		|ИЗ
		|	РегистрНакопления.БаллыПроектов.Обороты(, , , Проект = &Проект) КАК БаллыПроектовОбороты";
	Запрос.УстановитьПараметр("Проект", Проект);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.СуммарныйБалл;

КонецФункции

// Формирует рейтинг проектов указанного набора по суммарным баллам.
//
// Параметры:
//   Набор - СправочникСсылка.НаборыПроектов - набор (поток) проектов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - проекты с баллами, упорядоченные по убыванию балла.
//
Функция РейтингПроектовНабора(Набор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Проекты.Ссылка КАК Проект,
		|	ЕСТЬNULL(СУММА(БаллыПроектовОбороты.БаллыОборот), 0) КАК СуммарныйБалл
		|ИЗ
		|	Справочник.Проекты КАК Проекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БаллыПроектов.Обороты КАК БаллыПроектовОбороты
		|		ПО БаллыПроектовОбороты.Проект = Проекты.Ссылка
		|ГДЕ
		|	Проекты.Набор = &Набор
		|	И НЕ Проекты.ЭтоГруппа
		|
		|СГРУППИРОВАТЬ ПО
		|	Проекты.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	СуммарныйБалл УБЫВ";
	Запрос.УстановитьПараметр("Набор", Набор);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает текущий статус проекта на указанную дату.
//
// Параметры:
//   Проект - СправочникСсылка.Проекты - проект;
//   Период - Дата - дата среза (по умолчанию текущая).
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтатусыПроекта - актуальный статус.
//
Функция ТекущийСтатусПроекта(Проект, Период = Неопределено) Экспорт

	Если Период = Неопределено Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СтатусыПроектовСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.СтатусыПроектов.СрезПоследних(&Период, Проект = &Проект) КАК СтатусыПроектовСрезПоследних";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Проект", Проект);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	КонецЕсли;

	Возврат Перечисления.СтатусыПроекта.ЧерновикЗаявки;

КонецФункции

// Устанавливает реквизит «Статус» карточки проекта, если он изменился.
//
// Параметры:
//   Проект - СправочникСсылка.Проекты - проект;
//   Статус - ПеречислениеСсылка.СтатусыПроекта - новый статус.
//
Процедура УстановитьСтатусПроекта(Проект, Статус) Экспорт

	ПроектОбъект = Проект.ПолучитьОбъект();
	Если ПроектОбъект.Статус <> Статус Тогда
		ПроектОбъект.Статус = Статус;
		ПроектОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

// Устанавливает руководителя проекта, если он изменился.
//
// Параметры:
//   Проект - СправочникСсылка.Проекты - проект;
//   Руководитель - СправочникСсылка.Сотрудники - руководитель.
//
Процедура УстановитьРуководителяПроекта(Проект, Руководитель) Экспорт

	ПроектОбъект = Проект.ПолучитьОбъект();
	Если ПроектОбъект.Руководитель <> Руководитель Тогда
		ПроектОбъект.Руководитель = Руководитель;
		ПроектОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
