#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.БаллыПроектов.Записывать = Истина;

	// Итоговый балл рассчитывается автоматически с учётом весов критериев.
	ИтоговыйБалл = ПроектныйУчет.РассчитатьИтоговыйБалл(Баллы.Выгрузить());
	ПроведениеДокументов.ЗаписатьБаллыПроекта(Движения, Проект, Неопределено, Баллы.Выгрузить(), Дата);

	// Одобрение заявки возможно только при достижении проходного балла.
	Если РезультатЭкспертизы = Перечисления.РезультатыЭкспертизы.Одобрено
		И Не ПроектныйУчет.ПроходитПоБаллу(ИтоговыйБалл) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Итоговый балл %1 ниже проходного. Одобрение заявки невозможно.'"),
			Формат(ИтоговыйБалл, "ЧДЦ=2"));
		Сообщить(ТекстСообщения);
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
