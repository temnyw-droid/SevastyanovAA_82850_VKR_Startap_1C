#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.СтатусыПроектов.Записывать = Истина;
	Движения.ФинансированиеПроектов.Записывать = Истина;

	// Повторная регистрация активного проекта не допускается.
	ТекущийСтатус = ПроектныйУчет.ТекущийСтатусПроекта(Проект, Дата);
	Если ТекущийСтатус = Перечисления.СтатусыПроекта.Активен Тогда
		Сообщить(НСтр("ru = 'Проект уже зарегистрирован и активен.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПроведениеДокументов.ЗаписатьСтатусПроекта(Движения, Проект,
		Перечисления.СтатусыПроекта.Активен, Дата, НСтр("ru = 'Регистрация проекта'"));
	ПроведениеДокументов.ЗаписатьФинансирование(Движения, Проект, Финансирование.Выгрузить(), Дата);

	ПроектныйУчет.УстановитьСтатусПроекта(Проект, Перечисления.СтатусыПроекта.Активен);
	Если ЗначениеЗаполнено(Руководитель) Тогда
		ПроектныйУчет.УстановитьРуководителяПроекта(Проект, Руководитель);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
