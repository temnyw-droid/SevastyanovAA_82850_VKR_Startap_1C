#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.БаллыПроектов.Записывать = Истина;
	Движения.СтатусыПроектов.Записывать = Истина;

	// Итоговый балл защиты фиксируется в регистре.
	ИтоговыйБалл = ПроектныйУчет.РассчитатьИтоговыйБалл(Баллы.Выгрузить());
	ПроведениеДокументов.ЗаписатьБаллыПроекта(Движения, Проект, Неопределено, Баллы.Выгрузить(), Дата);

	// Решение комиссии определяет финальный статус проекта.
	Если РешениеКомиссии = Перечисления.РезультатыЭкспертизы.Одобрено Тогда
		НовыйСтатус = Перечисления.СтатусыПроекта.Защищен;
	ИначеЕсли РешениеКомиссии = Перечисления.РезультатыЭкспертизы.НаДоработку Тогда
		НовыйСтатус = Перечисления.СтатусыПроекта.Активен;
	Иначе
		НовыйСтатус = Перечисления.СтатусыПроекта.Отклонен;
	КонецЕсли;

	ПроведениеДокументов.ЗаписатьСтатусПроекта(Движения, Проект, НовыйСтатус, Дата,
		НСтр("ru = 'Защита проекта'"));
	ПроектныйУчет.УстановитьСтатусПроекта(Проект, НовыйСтатус);

КонецПроцедуры

#КонецОбласти
