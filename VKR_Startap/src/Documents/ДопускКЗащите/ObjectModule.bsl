#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.СтатусыПроектов.Записывать = Истина;

	// Допуск оформляется только при достижении проходного балла.
	СуммарныйБалл = ПроектныйУчет.СуммарныйБаллПроекта(Проект);
	Если Не ПроектныйУчет.ПроходитПоБаллу(СуммарныйБалл) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Суммарный балл проекта %1 ниже проходного. Допуск к защите невозможен.'"),
			Формат(СуммарныйБалл, "ЧДЦ=2"));
	КонецЕсли;

	ПроведениеДокументов.ЗаписатьСтатусПроекта(Движения, Проект,
		Перечисления.СтатусыПроекта.ДопущенКЗащите, Дата, НСтр("ru = 'Допуск к защите'"));
	ПроектныйУчет.УстановитьСтатусПроекта(Проект, Перечисления.СтатусыПроекта.ДопущенКЗащите);

КонецПроцедуры

#КонецОбласти
#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
